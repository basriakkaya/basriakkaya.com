---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, getPostsByCategory, getPostsBySeries, postSlug } from '../../../lib/posts';
import { absoluteUrl } from '../../../config/site';
import { breadcrumbSchema, schemaGraph } from '../../../lib/schema';
import { alternateLinks } from '../../../i18n/helpers';
import { categoryEntries, categoryTranslations } from '../../../config/categories';
import { seriesEntries, seriesTranslations } from '../../../config/series';
import { getCategoryLinkTitle, getSeriesLinkTitle } from '../../../lib/linkTitles';

const posts = await getPublishedPosts('en');
const activeCategories = (await Promise.all(categoryEntries.map(async ([key]) => ({ key, metadata: categoryTranslations[key], posts: await getPostsByCategory(key, 'en') })))).filter(({ posts }) => posts.length);
const activeSeries = (await Promise.all(seriesEntries.map(async ([key]) => ({ key, metadata: seriesTranslations[key], posts: await getPostsBySeries(key, 'en') })))).filter(({ posts }) => posts.length);
const categoryIcons: Record<string, string> = { 'web-guvenligi': '</>', 'ag-ve-linux': '↗↘', 'guvenlik-arastirmalari': '⌁', 'arac-gelistirme': '>_', 'kisisel-notlar': '::' };
const latestPosts = posts.slice(0, 4);
const jsonLd = schemaGraph([
  { '@type': 'CollectionPage', '@id': `${absoluteUrl('/en/articles')}#collection`, name: 'Cybersecurity Articles', url: absoluteUrl('/en/articles'), description: 'English technical articles about web security, networking, Linux, and security research.', inLanguage: 'en-US' },
  { '@type': 'ItemList', itemListElement: posts.map((post, index) => ({ '@type': 'ListItem', position: index + 1, name: post.data.title, url: absoluteUrl(`/en/articles/${postSlug(post)}`) })) },
  breadcrumbSchema([{ name: 'Home', path: '/en' }, { name: 'Articles', path: '/en/articles' }]),
]);
---
<BaseLayout locale="en" title="Cybersecurity Articles" description="English technical articles about web security, networking, Linux, and security research." alternates={alternateLinks('/yazilar', '/en/articles')} switchPath="/yazilar" jsonLd={jsonLd}>
  <section class="journal-hero shell" aria-labelledby="journal-title">
    <div class="journal-terminal" aria-hidden="true"><span></span><span></span><span></span><small>knowledge-index — zsh</small></div>
    <div class="journal-hero-content"><p class="eyebrow">CYBER RESEARCH JOURNAL / {posts.length.toString().padStart(2, '0')} ENTRIES</p><h1 id="journal-title">Research. Understand.<br />Document it in your own words.</h1><p>Applied research, learning journals, and technical notes on web security, networking, and Linux.</p></div>
    <div class="journal-command" aria-label="Active categories in the knowledge directory"><p><span>$</span> ls ~/knowledge</p><ul>{activeCategories.map(({ metadata }) => <li><a href={`/en/articles/category/${metadata.slug}`} title={getCategoryLinkTitle(metadata.name, 'en')}>{metadata.slug}/</a></li>)}</ul><p class="command-status">{activeSeries.length} active series · {posts.length} published research entries <span class="terminal-cursor" aria-hidden="true"></span></p></div>
  </section>

  <nav class="taxonomy-nav shell journal-nav" aria-label="Article categories"><a href="/en/articles" title="View all cybersecurity articles" aria-current="page">All Entries <span aria-hidden="true">{posts.length.toString().padStart(2, '0')}</span></a>{activeCategories.map(({ metadata, posts: categoryPosts }) => <a href={`/en/articles/category/${metadata.slug}`} title={getCategoryLinkTitle(metadata.name, 'en')}>{metadata.name} <span aria-hidden="true">{categoryPosts.length.toString().padStart(2, '0')}</span></a>)}</nav>

  <section class="section shell journal-categories" aria-labelledby="categories-title"><SectionHeading eyebrow="find ./knowledge -type d" title="Research Areas" description="Published work is organized by subject; counts come directly from the content collection." /><h2 id="categories-title" class="sr-only">Research areas</h2><div>{activeCategories.map(({ key, metadata, posts: categoryPosts }) => <a class="category-card" href={`/en/articles/category/${metadata.slug}`} title={getCategoryLinkTitle(metadata.name, 'en')}><span class="category-icon" aria-hidden="true">{categoryIcons[key]}</span><span class="category-count">{categoryPosts.length.toString().padStart(2, '0')} {categoryPosts.length === 1 ? 'ARTICLE' : 'ARTICLES'}</span><h3>{metadata.name}</h3><p>{metadata.description}</p><small>Explore area <span aria-hidden="true">→</span></small></a>)}</div></section>

  {activeSeries.length > 0 && <section class="section shell featured-series" aria-labelledby="featured-series-title"><SectionHeading eyebrow="cat ./series/active" title="Featured Series" description="Applied learning records that develop a subject progressively, one part at a time." /><h2 id="featured-series-title" class="sr-only">Featured series</h2><div class="series-feature-list">{activeSeries.map(({ metadata, posts: seriesPosts }) => <article class="series-feature"><div class="series-feature-copy"><span>ONGOING · {seriesPosts.length.toString().padStart(2, '0')} PARTS</span><h3>{metadata.title}</h3><p>{metadata.description}</p><a class="read-link" href={`/en/articles/series/${metadata.slug}`} title={getSeriesLinkTitle(metadata.title, 'en')}>Explore series <span aria-hidden="true">→</span></a></div><ol>{seriesPosts.map((post) => <li><a href={`/en/articles/${postSlug(post)}`} title={post.data.title}><span>{String(post.data.seriesOrder).padStart(2, '0')}</span><strong>{post.data.title.replace(/^Networking Learning Journal — Day \d+: /u, '')}</strong></a></li>)}</ol></article>)}</div></section>}

  <section class="section shell journal-latest" aria-labelledby="latest-posts"><SectionHeading eyebrow="ls ./articles --sort=newest" title="Latest Articles" description="The newest research and learning notes." /><h2 id="latest-posts" class="sr-only">Latest articles</h2><div class="post-grid">{latestPosts.map((post) => <PostCard post={post} locale="en" />)}</div></section>

  <section class="section shell category-groups" aria-labelledby="groups-title"><SectionHeading eyebrow="tree ./archive" title="Category Archive" description="Quick access to every publication by research area." /><h2 id="groups-title" class="sr-only">Category archive</h2><div>{activeCategories.map(({ key, metadata, posts: categoryPosts }) => <section aria-labelledby={`group-${key}`}><div><p>{categoryIcons[key]} / {categoryPosts.length.toString().padStart(2, '0')} ENTRIES</p><h3 id={`group-${key}`}>{metadata.name}</h3></div><ul>{categoryPosts.slice(0, 3).map((post) => <li><a href={`/en/articles/${postSlug(post)}`} title={post.data.title}><span>{post.data.title}</span><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('en-US')}</time></a></li>)}</ul><a class="read-link" href={`/en/articles/category/${metadata.slug}`} title={getCategoryLinkTitle(metadata.name, 'en')}>View all <span aria-hidden="true">→</span></a></section>)}</div></section>
</BaseLayout>
