---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPublishedPosts, postSlug } from '../../../lib/posts';
import { absoluteUrl } from '../../../config/site';
import { breadcrumbSchema, schemaGraph } from '../../../lib/schema';
import { alternateLinks } from '../../../i18n/helpers';
import { categoryEntries, categoryTranslations } from '../../../config/categories';
import { seriesEntries, seriesTranslations } from '../../../config/series';
import { getPostsByCategory, getPostsBySeries } from '../../../lib/posts';
const posts = await getPublishedPosts('en');
const activeCategories = (await Promise.all(categoryEntries.map(async ([key]) => ({ key, metadata: categoryTranslations[key], posts: await getPostsByCategory(key, 'en') })))).filter(({ posts }) => posts.length);
const activeSeries = (await Promise.all(seriesEntries.map(async ([key]) => ({ key, metadata: seriesTranslations[key], posts: await getPostsBySeries(key, 'en') })))).filter(({ posts }) => posts.length);
const jsonLd = schemaGraph([{ '@type': 'CollectionPage', '@id': `${absoluteUrl('/en/articles')}#collection`, name: 'Cybersecurity Articles', url: absoluteUrl('/en/articles'), description: 'English technical articles about web security, networking, Linux, and security research.', inLanguage: 'en-US' }, { '@type': 'ItemList', itemListElement: posts.map((post, index) => ({ '@type': 'ListItem', position: index + 1, name: post.data.title, url: absoluteUrl(`/en/articles/${postSlug(post)}`) })) }, breadcrumbSchema([{ name: 'Home', path: '/en' }, { name: 'Articles', path: '/en/articles' }])]);
---
<BaseLayout locale="en" title="Cybersecurity Articles" description="English technical articles about web security, networking, Linux, and security research." alternates={alternateLinks('/yazilar', '/en/articles')} switchPath="/yazilar" jsonLd={jsonLd}><section class="page-intro shell"><SectionHeading eyebrow="ls ./articles" title="Articles" description="In-depth, practical notes on cybersecurity, Linux, networking, and software development." as="h1" /></section><nav class="taxonomy-nav shell" aria-label="Article categories"><a href="/en/articles" aria-current="page" title="View all cybersecurity articles">All Articles <span aria-hidden="true">{posts.length}</span></a>{activeCategories.map(({ metadata, posts: categoryPosts }) => <a href={`/en/articles/category/${metadata.slug}`} title={`View ${metadata.name} articles`}>{metadata.name} <span aria-hidden="true">{categoryPosts.length}</span></a>)}</nav>{activeSeries.length > 0 && <section class="section shell series-list" aria-labelledby="english-series-title"><SectionHeading eyebrow="cat ./series" title="Series" description="Technical learning journals organized as connected, progressive parts." /><h2 id="english-series-title" class="sr-only">Article series</h2><div>{activeSeries.map(({ metadata, posts: seriesPosts }) => <a href={`/en/articles/series/${metadata.slug}`} title={`View the ${metadata.title} series`}><span>ONGOING</span><h3>{metadata.title}</h3><p>{metadata.description}</p><small>{seriesPosts.length} published parts</small></a>)}</div></section>}<section class="section shell" aria-labelledby="latest-posts"><h2 id="latest-posts" class="list-heading">Latest articles</h2><div class="post-grid">{posts.map((post) => <PostCard post={post} locale="en" />)}</div></section></BaseLayout>
