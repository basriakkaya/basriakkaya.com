---
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { getPublishedPosts, postSlug, type BlogPost } from '../../../lib/posts';
export async function getStaticPaths() { return (await getPublishedPosts('en')).map((post) => ({ params: { slug: postSlug(post) }, props: { post } })); }
const { post } = Astro.props as { post: BlogPost };
const { Content, headings } = await render(post);
---
<PostLayout post={post} headings={headings}><Content /></PostLayout>
