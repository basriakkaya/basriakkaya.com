---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialAbout from '../../components/EditorialAbout.astro';
import { siteConfig, absoluteUrl } from '../../config/site';
import { breadcrumbSchema, personSchema, schemaGraph } from '../../lib/schema';
import { alternateLinks } from '../../i18n/helpers';
const jsonLd = schemaGraph([
  personSchema,
  {
    '@type': 'ProfilePage',
    '@id': `${absoluteUrl('/en/about')}#profile`,
    name: `About | ${siteConfig.name}`,
    url: absoluteUrl('/en/about'),
    inLanguage: 'en-US',
    mainEntity: { '@id': `${absoluteUrl('/')}#person` },
  },
  breadcrumbSchema([
    { name: 'Home', path: '/en' },
    { name: 'About', path: '/en/about' },
  ]),
]);
---

<BaseLayout
  locale="en"
  title="About Basri Akkaya | Security Researcher"
  description="Learn about cybersecurity researcher and computer engineering student Basri Akkaya, his CVE work, projects, and technical experience."
  alternates={alternateLinks('/ben-kimim', '/en/about')}
  switchPath="/ben-kimim"
  jsonLd={jsonLd}
>
  <EditorialAbout locale="en" />
</BaseLayout>
