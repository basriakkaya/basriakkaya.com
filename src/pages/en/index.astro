---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { siteConfig, absoluteUrl } from '../../config/site';
import { personSchema, schemaGraph } from '../../lib/schema';
import { alternateLinks } from '../../i18n/helpers';
const posts = (await getPublishedPosts('en')).slice(0, 3);
const jsonLd = schemaGraph([personSchema, { '@type': 'WebSite', '@id': `${absoluteUrl('/en')}#website`, name: siteConfig.name, url: absoluteUrl('/en'), description: 'Cybersecurity research, responsible disclosure, Linux, and practical security notes by Basri Akkaya.', inLanguage: 'en-US', publisher: { '@id': `${absoluteUrl('/')}#person` } }]);
---
<BaseLayout locale="en" title="Basri Akkaya | Cybersecurity Researcher" description="Cybersecurity research, responsible disclosure, Linux, and practical security notes by Basri Akkaya." alternates={alternateLinks('/', '/en')} switchPath="/" jsonLd={jsonLd}>
  <div class="shell home-hero">
    <section class="hero-simple" aria-labelledby="hero-title"><div class="hero-content"><p class="hero-kicker">Security Research · Responsible Disclosure</p><h1 id="hero-title">{siteConfig.name}</h1><p class="role">Ethical Hacker | Network and Web Penetration Testing | Linux Enthusiast</p><p class="hero-motto">“Cybersecurity is not a hobby; it is a responsibility.”</p><p class="hero-copy">I study computer engineering and focus on web security, application security, penetration testing, and responsible disclosure.</p><div class="actions"><a class="button primary" href="/en/articles">Read the articles <span aria-hidden="true">→</span></a><a class="button secondary" href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></div></div></section>
  </div>
  <section class="section shell about-grid" aria-labelledby="about-title"><div><SectionHeading eyebrow="profile.summary" title="About me" /><p class="about-copy">I research security issues, report malicious infrastructure, and share practical notes from my learning process.</p><a class="read-link" href="/en/about">Learn more about Basri Akkaya <span aria-hidden="true">→</span></a></div><aside class="focus-panel" aria-label="Focus areas"><p class="panel-title">focus_areas</p><ul>{['Web Security', 'Application Security', 'Penetration Testing', 'Responsible Disclosure', 'Security Research', 'Linux'].map((item) => <li><span aria-hidden="true">›</span> {item}</li>)}</ul></aside></section>
  <section class="section shell" aria-labelledby="recent-title"><SectionHeading eyebrow="ls ./articles --recent" title="Recent articles" description="Concise, practical technical notes from my security work and learning." /><div class="post-grid">{posts.length ? posts.map((post) => <PostCard post={post} locale="en" />) : <p class="lead">English articles are being prepared. Turkish articles remain available through the language selector.</p>}</div></section>
</BaseLayout>
