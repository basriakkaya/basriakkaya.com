---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts } from '../../lib/posts';
import { absoluteUrl, siteConfig } from '../../config/site';
import { breadcrumbSchema, schemaGraph } from '../../lib/schema';
const posts = await getPublishedPosts();
const jsonLd = schemaGraph([
  { '@type': 'Blog', '@id': `${absoluteUrl('/yazilar')}#blog`, name: `${siteConfig.name} — Yazılar`, url: absoluteUrl('/yazilar'), description: 'Siber güvenlik, Linux ve yazılım geliştirme üzerine kısa teknik notlar.', inLanguage: siteConfig.locale },
  breadcrumbSchema([{ name: 'Ana Sayfa', path: '/' }, { name: 'Yazılar', path: '/yazilar' }]),
]);
---
<BaseLayout title="Siber Güvenlik Yazıları" description="Web güvenliği, Linux, ağ teknolojileri, etik hacking, güvenlik araştırmaları ve araç geliştirme üzerine Türkçe teknik yazılar." jsonLd={jsonLd}>
  <section class="page-intro shell"><SectionHeading eyebrow="ls ./yazilar" title="Yazılar" description="Siber güvenlik, Linux ve yazılım geliştirme üzerine kısa, doğrudan ve uygulanabilir notlar." as="h1" /></section>
  <section class="section shell" aria-label="Tüm yazılar"><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></section>
</BaseLayout>
