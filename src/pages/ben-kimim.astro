---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialAbout from '../components/EditorialAbout.astro';
import { siteConfig } from '../config/site';
import { absoluteUrl } from '../config/site';
import { breadcrumbSchema, personSchema, schemaGraph } from '../lib/schema';
import { alternateLinks } from '../i18n/helpers';
const jsonLd = schemaGraph([
  personSchema,
  {
    '@type': 'ProfilePage',
    '@id': `${absoluteUrl('/ben-kimim')}#profile`,
    name: `Ben Kimim? | ${siteConfig.name}`,
    url: absoluteUrl('/ben-kimim'),
    inLanguage: siteConfig.locale,
    mainEntity: { '@id': `${absoluteUrl('/')}#person` },
  },
  breadcrumbSchema([
    { name: 'Ana Sayfa', path: '/' },
    { name: 'Ben Kimim?', path: '/ben-kimim' },
  ]),
]);
---

<BaseLayout
  title="Basri Akkaya Hakkında | Güvenlik Araştırmacısı"
  description="Bilgisayar mühendisliği öğrencisi ve güvenlik araştırmacısı Basri Akkaya'nın çalışmaları, CVE kayıtları, projeleri ve teknik deneyimi."
  jsonLd={jsonLd}
  alternates={alternateLinks('/ben-kimim', '/en/about')}
  switchPath="/en/about"
>
  <EditorialAbout locale="tr" />
</BaseLayout>
