---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalHero from '../components/TerminalHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';
import { siteConfig, absoluteUrl } from '../config/site';
import { personSchema, schemaGraph } from '../lib/schema';
import { getExternalProfileLinkTitle, getNavigationLinkTitle } from '../lib/linkTitles';
import { alternateLinks } from '../i18n/helpers';
import HallOfFame from '../components/HallOfFame.astro';

const posts = (await getPublishedPosts()).slice(0, 3);
const jsonLd = schemaGraph([
  personSchema,
  { '@type': 'WebSite', '@id': `${absoluteUrl('/')}#website`, name: siteConfig.name, alternateName: ['Basri Akkaya Blog', 'Basri Akkaya Cybersecurity'], url: absoluteUrl('/'), description: siteConfig.description, inLanguage: siteConfig.locale, publisher: { '@id': `${absoluteUrl('/')}#person` } },
]);
---
<BaseLayout jsonLd={jsonLd} alternates={alternateLinks('/', '/en')} switchPath="/en">
  <div class="shell home-hero"><TerminalHero /></div>

  <section class="section shell about-grid" aria-labelledby="about-title">
    <div>
      <SectionHeading eyebrow="profil.ozeti" title="Ben Kimim?" />
      <p class="about-copy">{siteConfig.about}</p>
      <p class="about-note">Eğitimime devam ederken fakültemde staj yaptım. Üniversitemde tespit edip sorumlu açıklama çerçevesinde bildirdiğim bir güvenlik açığının görünürlük kazanması, bu süreci bir staj fırsatına dönüştürdü.</p>
      <a class="read-link" href="/ben-kimim" title={getNavigationLinkTitle('aboutDetails')}>Basri Akkaya Hakkında Daha Fazlası <span aria-hidden="true">→</span></a>
    </div>
    <aside class="focus-panel" aria-label="Odak alanlarım"><p class="panel-title">odak_alanlari</p><ul>{siteConfig.focus.map((item) => <li><span aria-hidden="true">›</span> {item}</li>)}</ul></aside>
  </section>

  <HallOfFame />

  <section class="section shell recognition-community" aria-labelledby="community-title">
    <div><SectionHeading eyebrow="topluluk.log" title="Topluluk & Medya" description="Bilgiyi yalnızca biriktirmek değil, paylaşılabilir ve uygulanabilir hâle getirmek." /></div>
    <aside class="community-card" aria-labelledby="community-title">
      <p class="card-label">topluluk / medya</p><h2 id="community-title">{siteConfig.community.name}</h2><p>{siteConfig.community.description}</p>
      <div class="text-links"><a href={siteConfig.community.website} title="BugHane Academy forumunu yeni sekmede aç" target="_blank" rel="noopener noreferrer">Forum <span aria-hidden="true">↗</span><span class="sr-only"> (yeni sekmede açılır)</span></a><a href={siteConfig.community.youtube} title="BugHane Academy YouTube kanalını yeni sekmede aç" target="_blank" rel="noopener noreferrer">YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (yeni sekmede açılır)</span></a></div>
    </aside>
  </section>

  <section class="section shell" aria-labelledby="recent-title">
    <div class="heading-row"><SectionHeading eyebrow="ls ./yazilar --recent" title="Son yazılar" description="Öğrenirken aldığım kısa, uygulanabilir teknik notlar." /><a class="all-link" href="/yazilar" title={getNavigationLinkTitle('allArticles')}>Siber Güvenlik Yazılarını Oku <span aria-hidden="true">→</span></a></div>
    <div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="section shell"><div class="contact-panel"><div><p class="eyebrow">$ ./iletisim.sh</p><h2>Bir konu hakkında iletişime geçmek mi istiyorsun?</h2><p>Teknik çalışmalar, güvenlik araştırmaları ve profesyonel iletişim için bana e-posta veya LinkedIn üzerinden ulaşabilirsin.</p></div><div class="actions"><a class="button primary" href={`mailto:${siteConfig.email}`}>E-posta Gönder</a><a class="button secondary" href={siteConfig.linkedin} title={getExternalProfileLinkTitle('LinkedIn')} target="_blank" rel="noopener noreferrer">LinkedIn Profili<span class="sr-only"> (yeni sekmede açılır)</span></a></div></div></section>
</BaseLayout>
