---
import { route } from '../i18n/routes';
import type { Locale } from '../i18n/config';
const { locale = 'tr', switchPath } = Astro.props as { locale: Locale; switchPath: string };
const en = locale === 'en';
const nav = [
  { href: route(locale, 'research'), label: en ? 'Research' : 'Araştırmalar' },
  { href: en ? '/en/videos' : '/videolar', label: en ? 'Videos' : 'Videolar' },
  { href: route(locale, 'articles'), label: 'Blog' },
  { href: en ? '/en/products' : '/urunler', label: en ? 'Products' : 'Ürünler' },
];
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a
      class="brand"
      title={en ? 'Home — Basri Akkaya' : 'Ana Sayfa — Basri Akkaya'}
      href={route(locale, 'home')}
    >
      <img src="/images/editorial/basrick-small.png" width="44" height="44" alt="" />
      <span>Basri Akkaya</span>
    </a>
    <button
      class="menu-button"
      aria-label={en ? 'Open menu' : 'Menüyü aç'}
      aria-controls="site-menu"
      aria-expanded="false"
    >
      ☰
    </button>
    <nav id="site-menu" class="site-nav" aria-label={en ? 'Main navigation' : 'Ana menü'}>
      {nav.map((n) => (
        <a
          title={n.label}
          href={n.href}
          aria-current={Astro.url.pathname.replace(/\/$/, '') === n.href ? 'page' : undefined}
        >
          {n.label}
        </a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="button contact-link" data-contact-open aria-haspopup="dialog">
        {en ? 'Contact' : 'İletişim'} ↗
      </button>
      <a
        class="language-link"
        title={en ? 'Türkçe sayfaya geç' : 'Switch to English'}
        href={switchPath}
        hreflang={en ? 'tr' : 'en'}
        aria-label={en ? 'Türkçe sayfaya geç' : 'Switch to English'}
      >
        <span class:list={{ active: !en }}>TR</span>
        <span aria-hidden="true"> / </span>
        <span class:list={{ active: en }}>EN</span>
      </a>
    </div>
  </div>
</header>
<script>
  const b = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.querySelector('#site-menu');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    b.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && b?.getAttribute('aria-expanded') === 'true') {
      b.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('is-open');
      b.focus();
    }
  });
</script>
