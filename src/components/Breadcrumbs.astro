---
interface Item { name: string; href?: string }
const { items } = Astro.props as { items: Item[] };
---
<nav class="breadcrumbs" aria-label="Sayfa yolu"><ol>{items.map((item, index) => <li>{item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}{index < items.length - 1 && <span aria-hidden="true">/</span>}</li>)}</ol></nav>
