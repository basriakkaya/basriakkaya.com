---
import { communityUrl } from '../data/editorial';
import type { Locale } from '../i18n/config';

interface Props { locale?: Locale; heading?: 'h2' | 'h3' }
const { locale = 'tr', heading: Heading = 'h3' } = Astro.props;
const en = locale === 'en';
const resources = [
  { id: 'kageterm', title: 'KageTerm', url: 'https://kageterm.com/', text: en ? 'Learn Linux commands by typing them.' : 'Linux komutlarını yazarak öğren.' },
  { id: 'kageai', title: 'KageAI', url: 'https://kageai.tech', text: en ? 'Explore KageAI.' : 'KageAI’ı keşfet.' },
  { id: 'basrick', title: en ? 'Basrick community' : 'Basrick topluluğu', url: communityUrl, text: en ? 'Join the conversation on Discord.' : 'Discord’da sohbete katıl.' },
];
---

<ul class="compact-resources">
  {resources.map(({ id, title, text, url }) => (
    <li id={id}>
      <a href={url} target="_blank" rel="noopener noreferrer">
        <Heading>{title}</Heading><span>{text}</span><i aria-hidden="true">↗</i>
      </a>
    </li>
  ))}
</ul>

<style>
  .compact-resources { list-style: none; padding: 0; margin: 0 0 24px; }
  .compact-resources li { border-bottom: 1px solid var(--border); }
  .compact-resources a { display: grid; grid-template-columns: minmax(8rem, 12rem) 1fr auto; align-items: center; gap: 4px 16px; min-height: 44px; padding: 9px 6px; color: inherit; }
  .compact-resources :is(h2, h3) { font-size: 1rem; line-height: 1.25; margin: 0; }
  .compact-resources span { font-size: .875rem; line-height: 1.4; color: #c5c2b7; }
  .compact-resources i { color: var(--accent); font-style: normal; }
  .compact-resources a:hover :is(h2,h3), .compact-resources a:focus-visible :is(h2,h3) { color: var(--accent); }
  @media (max-width: 540px) {
    .compact-resources a { grid-template-columns: 1fr auto; }
    .compact-resources span { grid-column: 1; }
    .compact-resources i { grid-column: 2; grid-row: 1 / 3; }
  }
</style>
