---
import { route } from '../i18n/routes';
import type { Locale } from '../i18n/config';
import PWAInstallPrompt from './PWAInstallPrompt.astro';
const { locale = 'tr' } = Astro.props as { locale: Locale };
const en = locale === 'en';
---

<footer class="footer shell">
  <div class="editorial-footer">
    <a
      class="brand"
      title={en ? 'Home — Basri Akkaya' : 'Ana Sayfa — Basri Akkaya'}
      href={route(locale, 'home')}
    >
      <img src="/images/editorial/basrick-small.png" width="38" height="38" alt="" />
      Basri Akkaya
    </a>
    <nav aria-label={en ? 'Footer navigation' : 'Alt menü'}>
      <a title={en ? 'About Basri Akkaya' : 'Basri Akkaya hakkında'} href={route(locale, 'about')}>
        {en ? 'About' : 'Hakkımda'}
      </a>
      <button data-contact-open aria-haspopup="dialog">
        {en ? 'Contact' : 'İletişim'}
      </button>
      <a href={en ? '/en/privacy' : '/gizlilik'}>{en ? 'Privacy' : 'Gizlilik'}</a>
      <a href={route(locale, 'security')}>{en ? 'Security' : 'Güvenlik'}</a>
      <a href={route(locale, 'rss')}>RSS</a>
      <a href="https://connect.basriakkaya.com/" target="_blank" rel="noopener noreferrer">
        Links ↗
      </a>
    </nav>
    <strong>{en ? 'Stay safe.' : 'Güvende kal.'}</strong>
  </div>
  <div class="footer-small">
    <span>© {new Date().getFullYear()} Basri Akkaya</span>
    <span>{en ? 'Research. Understand. Share.' : 'Araştır. Anla. Paylaş.'}</span>
    <PWAInstallPrompt locale={locale} />
  </div>
</footer>
