---
import ResearchStamp from './ResearchStamp.astro';
import HallOfFame from './HallOfFame.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Locale } from '../i18n/config';
import { alternateLinks, formatDate } from '../i18n/helpers';
import { cveResearchRoute, route } from '../i18n/routes';
import { absoluteUrl, siteConfig } from '../config/site';
import { breadcrumbSchema, personSchema, schemaGraph } from '../lib/schema';
import { pendingCves, publishedCves } from '../lib/security-research';

const { locale } = Astro.props as { locale: Locale };
const isEnglish = locale === 'en';
const trPath = route('tr', 'research');
const enPath = route('en', 'research');
const currentPath = isEnglish ? enPath : trPath;
const aboutPath = '#hof-title';
const copy = isEnglish
  ? {
      home: 'Home',
      eyebrow: 'cat ./verified-research.log',
      title: 'Security Research & CVE Records',
      description:
        'Publicly verifiable vulnerability research by Basri Akkaya, linked to official CVE records, government advisories, and researcher credits.',
      published: 'Published and independently verifiable',
      intro:
        'Each research page connects the CVE identifier, affected product, technical classification, publication date, and “Basri Akkaya — finder” credit to authoritative sources.',
      finder: 'Credited finder',
      details: 'View research record',
      official: 'Official CVE record',
      publishedLabel: 'Published',
      pending: 'Publication pending',
      pendingText:
        'The identifier below is kept separate from published research. No technical claims or finder structured data will be emitted until an authoritative public CVE record exists.',
      check: 'Check CVE status',
      verification: 'Verification methodology',
      verificationText:
        'Published CVE facts are taken from the CVE Program record and the linked TR-CERT government advisory. Hall of Fame and recognition evidence is listed in the Hall of Fame section of this page with its original source.',
      profile: 'View Hall of Fame and recognition evidence',
      newTab: ' (opens in a new tab)',
    }
  : {
      home: 'Ana Sayfa',
      eyebrow: 'cat ./dogrulanmis-arastirmalar.log',
      title: 'Güvenlik Araştırmaları ve CVE Kayıtları',
      description:
        'Basri Akkaya tarafından yürütülen, resmî CVE kayıtları, devlet bildirimleri ve araştırmacı kredileriyle kaynaklandırılmış güvenlik araştırmaları.',
      published: 'Yayımlanmış ve bağımsız doğrulanabilir',
      intro:
        'Her araştırma sayfası CVE kimliğini, etkilenen ürünü, teknik sınıflandırmayı, yayın tarihini ve “Basri Akkaya — finder” kredisini yetkili kaynaklarla ilişkilendirir.',
      finder: 'Kredilendirilen araştırmacı',
      details: 'Araştırma kaydını görüntüle',
      official: 'Resmî CVE kaydı',
      publishedLabel: 'Yayımlandı',
      pending: 'Yayın bekleniyor',
      pendingText:
        'Aşağıdaki kimlik yayımlanmış araştırmalardan ayrı tutulur. Yetkili kamu kaydı oluşana kadar teknik iddia veya finder yapılandırılmış verisi üretilmez.',
      check: 'CVE durumunu kontrol et',
      verification: 'Doğrulama yöntemi',
      verificationText:
        'Yayımlanmış CVE bilgileri CVE Programı kaydı ve bağlantılı TR-CERT devlet bildiriminden alınır. Hall of Fame ve takdir kanıtları, özgün kaynaklarıyla bu sayfadaki Hall of Fame bölümünde gösterilir.',
      profile: 'Hall of Fame ve takdir kanıtlarını görüntüle',
      newTab: ' (yeni sekmede açılır)',
    };
const itemList = publishedCves.map((cve, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: `${cve.id} — ${isEnglish ? cve.title : cve.titleTr}`,
  url: absoluteUrl(cveResearchRoute(locale, cve.id)),
}));
const jsonLd = schemaGraph([
  personSchema,
  {
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl(currentPath)}#collection`,
    name: copy.title,
    description: copy.description,
    url: absoluteUrl(currentPath),
    inLanguage: isEnglish ? 'en-US' : 'tr-TR',
    about: { '@id': `${absoluteUrl('/')}#person` },
    mainEntity: { '@id': `${absoluteUrl(currentPath)}#items` },
  },
  {
    '@type': 'ItemList',
    '@id': `${absoluteUrl(currentPath)}#items`,
    numberOfItems: itemList.length,
    itemListElement: itemList,
  },
  breadcrumbSchema([
    { name: copy.home, path: isEnglish ? '/en' : '/' },
    { name: copy.title, path: currentPath },
  ]),
]);
---

<BaseLayout
  locale={locale}
  title={`${copy.title} | ${siteConfig.name}`}
  description={copy.description}
  canonicalPath={currentPath}
  alternates={alternateLinks(trPath, enPath)}
  switchPath={isEnglish ? trPath : enPath}
  jsonLd={jsonLd}
>
  <div class="defcon-research">
    <section class="research-index page-intro shell research-visual-head">
      <img class="research-skull-backdrop" src="/images/editorial/basrick.png" width="600" height="600" alt="" aria-hidden="true" />
      <div class="research-index-copy">
        <Breadcrumbs
          items={[{ name: copy.home, href: isEnglish ? '/en' : '/' }, { name: copy.title }]}
        />
        <p class="eyebrow">{isEnglish ? 'RESPONSIBLE DISCLOSURE' : 'SORUMLU AÇIKLAMA'}</p>
        <h1>
          {isEnglish ? 'From curiosity' : 'Meraktan'}
          <br />
          <em>{isEnglish ? 'to evidence.' : 'kanıta.'}</em>
        </h1>
        <p class="ed-lead">{copy.description}</p>
      </div>
      <div class="research-dial">
        <div>
          <strong>{publishedCves.length}</strong>
          <span>{isEnglish ? 'Published CVEs' : 'Yayımlanmış CVE'}</span>
        </div>
        <div>
          <strong>
            {siteConfig.achievements.filter((item) => !item.title.includes('CTF')).length}
          </strong>
          <span>{isEnglish ? 'Recognition records' : 'Takdir kaydı'}</span>
        </div>
      </div>
    </section>

    <nav
      class="filter-chips shell research-filters"
      aria-label={isEnglish ? 'Research sections' : 'Araştırma bölümleri'}
    >
      <button data-research-filter="all" aria-pressed="true">
        {isEnglish ? 'All' : 'Tümü'}
      </button>
      <button data-research-filter="hof" aria-pressed="false">
        Hall of Fame
      </button>
      <button data-research-filter="cve" aria-pressed="false">
        CVE
      </button>
      <button data-research-filter="process" aria-pressed="false">
        {isEnglish ? 'Process' : 'Süreç'}
      </button>
    </nav>
    <div class="research-hof" data-research-group="hof">
      <HallOfFame locale={locale} scope="hof" />
    </div>
    <section
      class="section shell research-records"
      data-research-group="cve"
      aria-labelledby="published-research"
    >
      <header>
        <h2 id="published-research">{copy.published}</h2>
        <p>{copy.intro}</p>
      </header>
      <div class="research-record-grid">
        {publishedCves.map((cve) => (
          <article class="research-record-card">
            <ResearchStamp english={isEnglish} />
            <div class="record-score" aria-label={`CVSS ${cve.score}`}>
              {cve.score.toFixed(1)}
              <small>CVSS</small>
            </div>
            <div class="research-record-meta">
              <span>{copy.publishedLabel}</span>
              <time datetime={cve.published}>
                {formatDate(new Date(`${cve.published}T12:00:00Z`), locale)}
              </time>
            </div>
            <h3>
              <a href={cveResearchRoute(locale, cve.id)}>{cve.id}</a>
            </h3>
            <p class="research-record-title">{isEnglish ? cve.title : cve.titleTr}</p>
            <p>{isEnglish ? cve.description : cve.descriptionTr}</p>
            <dl>
              <div>
                <dt>{copy.finder}</dt>
                <dd>Basri Akkaya</dd>
              </div>
              <div>
                <dt>CVSS</dt>
                <dd>
                  {cve.score.toFixed(1)} · {isEnglish ? cve.severity : cve.severityTr}
                </dd>
              </div>
              <div>
                <dt>CWE</dt>
                <dd>{cve.cwe}</dd>
              </div>
            </dl>
            <div class="research-record-actions">
              <a href={cveResearchRoute(locale, cve.id)}>
                {copy.details} <span aria-hidden="true">→</span>
              </a>
              <a href={cve.url} target="_blank" rel="noopener noreferrer">
                {copy.official} <span aria-hidden="true">↗</span>
                <span class="sr-only">{copy.newTab}</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {pendingCves.length > 0 && (
      <section
        class="section shell pending-research"
        data-research-group="cve"
        aria-labelledby="pending-research"
      >
        <div>
          <h2 id="pending-research">{copy.pending}</h2>
          <p>{copy.pendingText}</p>
        </div>
        <ul>
          {pendingCves.map((cve) => (
            <li>
              <div>
                <strong>{cve.id}</strong>
                <span>{isEnglish ? cve.description : cve.descriptionTr}</span>
              </div>
              <a href={cve.url} target="_blank" rel="noopener noreferrer">
                {copy.check} <span aria-hidden="true">↗</span>
                <span class="sr-only">{copy.newTab}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="shell research-process" data-research-group="process">
      <img src="/images/editorial/process.webp" width="700" height="400" alt="" loading="lazy" />
      <div>
        <p class="eyebrow">{isEnglish ? 'THE PROCESS' : 'SÜREÇ'}</p>
        <h2>{isEnglish ? 'Behind every finding' : 'Bir açığın arkasındaki süreç'}</h2>
        <ol>
          <li>
            <strong>{isEnglish ? 'Discovery' : 'Keşif'}</strong>
            <p>
              {isEnglish
                ? 'Identify and validate the security issue.'
                : 'Güvenlik probleminin tespit edilmesi ve doğrulanması.'}
            </p>
          </li>
          <li>
            <strong>{isEnglish ? 'Reporting' : 'Raporlama'}</strong>
            <p>
              {isEnglish
                ? 'Coordinate a private report with the responsible team.'
                : 'İlgili ekiple güvenli ve koordineli şekilde iletişim kurulması.'}
            </p>
          </li>
          <li>
            <strong>{isEnglish ? 'Remediation' : 'Düzeltme'}</strong>
            <p>
              {isEnglish
                ? 'Verify remediation and agree on appropriate disclosure.'
                : 'Sorunun giderilmesi ve uygun açıklama kapsamının belirlenmesi.'}
            </p>
          </li>
        </ol>
      </div>
    </section>
    <section class="section shell verification-method" aria-labelledby="verification-method">
      <div>
        <h2 id="verification-method">{copy.verification}</h2>
        <p>{copy.verificationText}</p>
      </div>
      <a
        class="button secondary"
        href={aboutPath}
        title={
          isEnglish
            ? 'View Basri Akkaya’s Hall of Fame and recognition evidence'
            : 'Basri Akkaya Hall of Fame ve takdir kanıtlarını görüntüle'
        }
      >
        {copy.profile} <span aria-hidden="true">→</span>
      </a>
    </section>
    <section class="shell research-contact">
      <div>
        <h2>{isEnglish ? 'A safer internet. Together.' : 'Birlikte daha güvenli bir internet.'}</h2>
        <p>
          {isEnglish
            ? 'Get in touch about responsible research, collaboration or questions.'
            : 'Sorumlu güvenlik araştırmaları, teknik iş birlikleri veya soruların için iletişime geçebilirsin.'}
        </p>
        <button class="button primary" data-contact-open aria-haspopup="dialog">
          {isEnglish ? 'Get in touch' : 'İletişime geç'} ↗
        </button>
      </div>
      <img src="/images/editorial/globe.webp" alt="" width="700" height="400" loading="lazy" />
    </section>
  </div>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-research-filter]').forEach((button) =>
    button.addEventListener('click', () => {
      const filter = button.dataset.researchFilter;
      document
        .querySelectorAll('[data-research-filter]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      document
        .querySelectorAll<HTMLElement>('[data-research-group]')
        .forEach(
          (group) => (group.hidden = filter !== 'all' && group.dataset.researchGroup !== filter),
        );
    }),
  );
</script>

<style>
  .research-index {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 32px;
  }
  .research-index-copy {
    max-width: 820px;
  }
  .research-trust {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 11px 14px;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font:
      10px ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .research-trust span {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(248, 204, 72, 0.7);
  }
  .research-trust strong {
    color: var(--accent);
    font-size: 1rem;
  }
  .research-records {
    padding-top: 54px;
  }
  .research-records > header {
    max-width: 820px;
    margin-bottom: 28px;
  }
  .research-records > header h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .research-records > header p {
    margin: 12px 0 0;
    color: var(--muted);
  }
  .research-record-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .research-record-card {
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent-2);
    border-radius: 9px;
  }
  .research-record-card h3 {
    margin: 14px 0 8px;
    color: var(--accent-2);
    font:
      800 clamp(1.5rem, 4vw, 2rem) ui-monospace,
      monospace;
  }
  .research-record-card h3 a:after {
    position: absolute;
    inset: 0;
    content: '';
  }
  .research-record-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    font:
      10px ui-monospace,
      monospace;
    text-transform: uppercase;
  }
  .research-record-meta span {
    color: var(--accent);
  }
  .research-record-title {
    color: var(--text) !important;
    font-weight: 750;
  }
  .research-record-card > p {
    margin: 7px 0;
    color: var(--muted);
  }
  .research-record-card dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 18px 0;
  }
  .research-record-card dl div {
    min-width: 0;
    padding: 10px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 5px;
  }
  .research-record-card dt {
    color: var(--muted);
    font:
      8px ui-monospace,
      monospace;
    text-transform: uppercase;
  }
  .research-record-card dd {
    margin: 3px 0 0;
    overflow-wrap: anywhere;
    color: var(--text);
    font:
      700 10px ui-monospace,
      monospace;
  }
  .research-record-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 12px;
  }
  .research-record-actions a {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    padding: 7px 11px;
    color: var(--accent-2);
    border: 1px solid var(--border);
    border-radius: 5px;
    font:
      700 11px ui-monospace,
      monospace;
  }
  .research-record-actions a:hover {
    color: var(--text);
    border-color: var(--accent-2);
  }
  .pending-research {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    border-top: 1px solid var(--border);
  }
  .pending-research h2,
  .verification-method h2 {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }
  .pending-research > div > p:last-child,
  .verification-method > div > p:last-child {
    margin-top: 12px;
    color: var(--muted);
  }
  .pending-research ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pending-research li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 17px;
    background: var(--surface);
    border: 1px solid #454545;
    border-left: 3px solid #f8cc48;
    border-radius: 7px;
  }
  .pending-research li div {
    display: grid;
    min-width: 0;
  }
  .pending-research li strong {
    color: #f8cc48;
    font:
      800 1rem ui-monospace,
      monospace;
  }
  .pending-research li span {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .pending-research li a {
    flex: 0 0 auto;
    color: var(--accent-2);
    font:
      700 11px ui-monospace,
      monospace;
  }
  .verification-method {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 44px;
    border-top: 1px solid var(--border);
  }
  .verification-method > div {
    max-width: 760px;
  }
  .verification-method .button {
    flex: 0 0 auto;
  }
  @media (max-width: 800px) {
    .research-index {
      grid-template-columns: 1fr;
    }
    .research-trust {
      justify-self: start;
    }
    .research-record-grid,
    .pending-research {
      grid-template-columns: 1fr;
    }
    .verification-method {
      align-items: flex-start;
      flex-direction: column;
    }
    .verification-method .button {
      width: 100%;
    }
  }
  @media (max-width: 520px) {
    .research-record-card {
      padding: 20px;
    }
    .research-record-card dl {
      grid-template-columns: 1fr;
    }
    .research-record-actions {
      display: grid;
    }
    .research-record-actions a {
      justify-content: center;
    }
    .pending-research li {
      align-items: flex-start;
      flex-direction: column;
    }
    .pending-research li a {
      min-height: 44px;
      display: flex;
      align-items: center;
    }
    .research-trust {
      line-height: 1.4;
    }
  }
</style>

<script>
  document
    .querySelector('a[href="#hof-title"]')
    ?.addEventListener('click', () =>
      document.querySelector<HTMLButtonElement>('[data-research-filter="hof"]')?.click(),
    );
</script>
