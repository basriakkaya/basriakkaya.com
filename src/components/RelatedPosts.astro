---
import type { BlogPost } from '../lib/posts';
import PostCard from './PostCard.astro';
const { posts } = Astro.props as { posts: BlogPost[] };
---
{posts.length > 0 && <section class="related-posts" aria-labelledby="related-title"><h2 id="related-title">Benzer Yazılar</h2><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></section>}
