---
import SectionHeading from './SectionHeading.astro';
import AchievementCard from './AchievementCard.astro';
import { siteConfig } from '../config/site';

interface Props { locale?: 'tr' | 'en'; scope?: 'all' | 'security' }
const { locale = 'tr', scope = 'all' } = Astro.props;
const isEnglish = locale === 'en';
const securityOnly = scope === 'security';

const copy = isEnglish ? {
  title: 'Hall of Fame & CVE Records',
  description: 'Publicly verifiable security research, responsible disclosure, and recognition records — grouped for quick review.',
  summary: 'Recognition record summary', records: 'records', verified: 'Verified', verify: 'View official record',
  newTab: ' (opens in a new tab)', archive: 'This institutional record is archived; no public link is available.',
  hofTitle: 'Hall of Fame', hofDescription: 'Recognition received for responsibly reported and validated security findings.',
  cveTitle: 'CVE Records', cveDescription: 'Public vulnerability identifiers assigned through coordinated disclosure.',
  moreTitle: 'Competitions & Recognition', moreDescription: 'Competition results and institutional recognition supporting the research journey.',
  publicRecord: 'Public record', archived: 'Archived', institutional: 'Institutional',
} : {
  title: 'Hall of Fame & CVE Kayıtları',
  description: 'Kamuya açık olarak doğrulanabilen güvenlik araştırmaları, sorumlu açıklama ve başarı kayıtları — hızlı inceleme için gruplandırıldı.',
  summary: 'Başarı kayıtlarının özeti', records: 'kayıt', verified: 'Doğrulandı', verify: 'Resmî kaydı görüntüle',
  newTab: ' (yeni sekmede açılır)', archive: 'Bu kurumsal kayıt arşivlidir; herkese açık bağlantısı bulunmuyor.',
  hofTitle: 'Hall of Fame', hofDescription: 'Sorumlu şekilde bildirilen ve doğrulanan güvenlik bulguları için alınan resmî takdirler.',
  cveTitle: 'CVE Kayıtları', cveDescription: 'Koordineli açıklama süreci sonunda atanmış, kamuya açık güvenlik açığı kimlikleri.',
  moreTitle: 'Yarışmalar & Takdirler', moreDescription: 'Güvenlik araştırması yolculuğunu destekleyen yarışma dereceleri ve kurumsal takdirler.',
  publicRecord: 'Kamuya açık kayıt', archived: 'Arşiv', institutional: 'Kurumsal',
};

const brandFor = (title: string) => {
  if (title.includes('Twente')) return { logo: '/images/recognition/university-of-twente.svg', name: 'University of Twente' };
  if (title.includes('Arçelik')) return { logo: '/images/recognition/arcelik.png', name: 'Arçelik' };
  return undefined;
};

const cveRecords = siteConfig.cves.map((item) => ({
  category: 'cve', label: 'CVE', title: item.id,
  description: isEnglish ? 'Coordinated vulnerability disclosure record with a public CVE identifier.' : 'Kamuya açık CVE kimliğine sahip koordineli güvenlik açığı açıklama kaydı.',
  url: item.url, year: item.id.match(/CVE-(\d{4})/)?.[1], brand: undefined,
}));

const achievementRecords = siteConfig.achievements.map((item) => {
  const category = item.title.includes('CTF') ? 'ctf' : 'hof';
  return {
    category, label: category === 'ctf' ? 'CTF' : 'HOF',
    title: isEnglish ? item.titleEn : item.title,
    description: isEnglish ? item.descriptionEn : item.description,
    url: item.url, year: item.title.match(/\b(20\d{2})\b/)?.[1], brand: brandFor(item.title),
  };
});

const institutionalRecords = siteConfig.recognition.map((item) => ({
  category: 'institution', label: copy.institutional,
  title: isEnglish ? item.titleEn : item.title,
  description: isEnglish ? item.descriptionEn : item.description,
  url: item.url, year: undefined, brand: undefined,
}));

const hofRecords = achievementRecords.filter((record) => record.category === 'hof');
const otherRecords = [...achievementRecords.filter((record) => record.category === 'ctf'), ...institutionalRecords];
const records = securityOnly ? [...hofRecords, ...cveRecords] : [...hofRecords, ...cveRecords, ...otherRecords];

---

<section class="section shell hof-section" aria-labelledby="hof-title">
  <div class="hof-heading">
    <SectionHeading eyebrow="cat verified_records.log" title={copy.title} description={copy.description} />
    <div class:list={['hof-summary', { 'hof-summary--security': securityOnly }]} aria-label={copy.summary}>
      <span><strong>{records.length}</strong> {copy.records}</span>
      <span><strong>{cveRecords.length}</strong> CVE</span>
      <span><strong>{hofRecords.length}</strong> HOF</span>
      {!securityOnly && <span><strong>{otherRecords.length}</strong> {isEnglish ? 'OTHER' : 'DİĞER'}</span>}
    </div>
  </div>

  <div class="achievement-showcase">
    <section class="achievement-group" aria-labelledby="hof-group-title">
      <header class="achievement-group-heading">
        <span class="achievement-group-index" aria-hidden="true">01</span>
        <div><h3 id="hof-group-title">{copy.hofTitle}</h3><p>{copy.hofDescription}</p></div>
        <strong>{hofRecords.length}</strong>
      </header>
      <div class="achievement-grid achievement-grid--featured">
        {hofRecords.map((record) => <AchievementCard record={record} copy={copy} featured />)}
      </div>
    </section>

    <section class="achievement-group" aria-labelledby="cve-group-title">
      <header class="achievement-group-heading">
        <span class="achievement-group-index" aria-hidden="true">02</span>
        <div><h3 id="cve-group-title">{copy.cveTitle}</h3><p>{copy.cveDescription}</p></div>
        <strong>{cveRecords.length}</strong>
      </header>
      <div class="achievement-grid achievement-grid--cve">
        {cveRecords.map((record) => <AchievementCard record={record} copy={copy} />)}
      </div>
    </section>

    {!securityOnly && (
      <section class="achievement-group" aria-labelledby="more-group-title">
        <header class="achievement-group-heading">
          <span class="achievement-group-index" aria-hidden="true">03</span>
          <div><h3 id="more-group-title">{copy.moreTitle}</h3><p>{copy.moreDescription}</p></div>
          <strong>{otherRecords.length}</strong>
        </header>
        <div class="achievement-grid achievement-grid--compact">
          {otherRecords.map((record) => <AchievementCard record={record} copy={copy} />)}
        </div>
      </section>
    )}
  </div>
</section>
