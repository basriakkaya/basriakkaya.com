---
import type { MarkdownHeading } from 'astro';
const { headings, mode } = Astro.props as { headings: MarkdownHeading[]; mode: 'mobile' | 'desktop' };
const entries = headings.filter(({ depth }) => depth === 2 || depth === 3);
const enabled = entries.length >= 2;
---
{enabled && mode === 'mobile' && <details class="toc-mobile"><summary>İçindekiler · {entries.length} bölüm</summary><nav aria-label="Bu yazının bölümleri"><ol>{entries.map((heading) => <li class:list={{ 'toc-h3': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav></details>}
{enabled && mode === 'desktop' && <aside class="toc-desktop" aria-label="Yazı içindekiler" data-article-toc><p>İçindekiler</p><nav aria-label="Bu yazının bölümleri"><ol>{entries.map((heading) => <li class:list={{ 'toc-h3': heading.depth === 3 }}><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}</ol></nav></aside>}
