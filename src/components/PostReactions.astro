---
interface Props { slug: string; locale?: 'tr' | 'en' }
const { slug, locale = 'tr' } = Astro.props;
const storageKey = locale === 'tr' ? `basri:post-reaction:${slug}` : `basri:post-reaction:en:${slug}`;
const reactionCopy = locale === 'tr' ? {
  title: 'Bu yazı sende ne bıraktı?', intro: 'Bir reaction seç. Kararını daha sonra değiştirebilirsin.', privacy: 'Bu seçim yalnızca bu tarayıcıda saklanır. Herhangi bir kişisel veri veya reaction bilgisi sunucuya gönderilmez.', noscript: 'Reaction kaydetmek için JavaScript etkin olmalıdır.', saved: 'reaction yerel olarak kaydedildi ✓', updated: 'reaction güncellendi ✓', failed: 'Reaction bu tarayıcıda saklanamadı.',
  reactions: [
    { value: 'recon', name: 'RECON', short: 'Yeni bir şey öğrendim.', detail: 'Bu yazı bana yeni bir bilgi veya bakış açısı kazandırdı.' },
    { value: 'patch', name: 'PATCH', short: 'Pratikte işime yaradı.', detail: 'Bu yazı bir problemi çözmeme veya konuyu daha iyi anlamama yardımcı oldu.' },
    { value: 'root', name: 'ROOT', short: 'Bu içerik aklımda kalacak.', detail: 'Bu yazı beni etkiledi ve daha sonra tekrar hatırlamak isteyeceğim.' },
  ],
} : {
  title: 'What did this article leave with you?', intro: 'Choose one reaction. You can change your choice later.', privacy: 'This choice is stored only in this browser. No personal data or reaction information is sent to a server.', noscript: 'JavaScript is required to save a reaction.', saved: 'reaction saved locally ✓', updated: 'reaction updated ✓', failed: 'The reaction could not be stored in this browser.',
  reactions: [
    { value: 'recon', name: 'RECON', short: 'I learned something new.', detail: 'This article gave me new information or a new perspective.' },
    { value: 'patch', name: 'PATCH', short: 'I can apply this.', detail: 'This article helped me solve a problem or understand the subject better.' },
    { value: 'root', name: 'ROOT', short: 'This will stay with me.', detail: 'This article made an impression and is something I will want to remember.' },
  ],
};
const reactions = reactionCopy.reactions;
---

<section class="post-reactions" aria-labelledby={`reaction-title-${slug}`} data-post-reactions data-storage-key={storageKey} data-saved-message={reactionCopy.saved} data-updated-message={reactionCopy.updated} data-failed-message={reactionCopy.failed}>
  <p class="reaction-command">$ leave_reaction --one</p>
  <h2 id={`reaction-title-${slug}`}>{reactionCopy.title}</h2>
  <p class="reaction-intro">{reactionCopy.intro}</p>
  <div class="reaction-options">
    {reactions.map((reaction) => (
      <button type="button" class="reaction-option" data-reaction={reaction.value} aria-pressed="false" aria-label={`${reaction.name} reaction: ${reaction.short}`} aria-describedby={`reaction-detail-${slug}-${reaction.value}`}>
        <span class="reaction-name">{reaction.name}</span>
        <span class="reaction-short">{reaction.short}</span>
        <span class="reaction-detail" id={`reaction-detail-${slug}-${reaction.value}`} role="tooltip">{reaction.detail}</span>
      </button>
    ))}
  </div>
  <p class="reaction-status" aria-live="polite" data-reaction-status></p>
  <p class="reaction-privacy">{reactionCopy.privacy}</p>
  <noscript><p class="reaction-noscript">{reactionCopy.noscript}</p></noscript>
</section>

<script>
  const allowedReactions = new Set(['recon', 'patch', 'root']);

  function initializeReactions() {
    document.querySelectorAll<HTMLElement>('[data-post-reactions]').forEach((container) => {
      if (container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';
      const storageKey = container.dataset.storageKey;
      const buttons = Array.from(container.querySelectorAll<HTMLButtonElement>('[data-reaction]'));
      const status = container.querySelector<HTMLElement>('[data-reaction-status]');
      if (!storageKey || !status) return;
      const select = (value: string | null) => buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.reaction === value)));
      let current: string | null = null;
      try {
        const stored = localStorage.getItem(storageKey);
        if (stored && allowedReactions.has(stored)) current = stored;
        else if (stored) localStorage.removeItem(storageKey);
      } catch { /* Depolama kapalıysa yazı ve butonlar kullanılabilir kalır. */ }
      select(current);
      buttons.forEach((button) => button.addEventListener('click', () => {
        const next = button.dataset.reaction;
        if (!next || !allowedReactions.has(next)) return;
        const changed = current !== null && current !== next;
        try {
          localStorage.setItem(storageKey, next);
          current = next;
          select(next);
          status.textContent = changed ? (container.dataset.updatedMessage ?? '') : (container.dataset.savedMessage ?? '');
        } catch {
          status.textContent = container.dataset.failedMessage ?? '';
        }
      }));
    });
  }
  initializeReactions();
  document.addEventListener('astro:page-load', initializeReactions);
</script>
