<main id="admin-main" class="admin-shell">
  <section class="admin-card" aria-labelledby="admin-title">
    <div class="admin-content">
      <header class="admin-heading">
        <h1 id="admin-title">Admin Login</h1>
        <p>Sign in to continue.</p>
      </header>

      <form class="admin-form" data-admin-form autocomplete="off" novalidate>
        <div class="admin-field">
          <label for="operator-id">Username</label>
          <input id="operator-id" name="operator" type="text" inputmode="text" autocomplete="off" spellcheck="false" required />
        </div>
        <div class="admin-field">
          <label for="access-key">Password</label>
          <input id="access-key" name="access-key" type="password" autocomplete="new-password" required />
        </div>
        <button type="submit">Sign in</button>
        <p class="admin-response" data-admin-response aria-live="polite"></p>
      </form>

      <p class="admin-client">IP address: <span data-client-ip aria-live="polite">resolving…</span></p>
    </div>
  </section>
</main>
<script src="../../scripts/operations-console.ts"></script>
