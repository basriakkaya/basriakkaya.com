---
interface RecordItem {
  category: string;
  label: string;
  title: string;
  description: string;
  url?: string;
  year?: string;
  brand?: { logo: string; name: string };
  status?: string;
  findings?: readonly string[];
  evidence?: string;
  evidenceAlt?: string;
  evidenceWidth?: number;
  evidenceHeight?: number;
  evidenceId?: string;
  findingTitle?: string;
  secondaryUrl?: string;
  vendor?: string;
  product?: string;
  severity?: string;
  score?: number;
  cvssVersion?: string;
}

interface Copy {
  verify: string;
  newTab: string;
  archive: string;
  publicRecord: string;
  archived: string;
  institutional: string;
  evidence: string;
  closeEvidence: string;
  advisory: string;
  company: string;
  product: string;
  severity: string;
}

interface Props { record: RecordItem; copy: Copy; featured?: boolean }
const { record, copy, featured = false } = Astro.props;
---

<article class:list={['achievement-card', `achievement-card--${record.category}`, { 'achievement-card--featured': featured }]}> 
  <div class="achievement-card-top">
    {record.brand ? (
      <span class="achievement-logo-frame"><img src={record.brand.logo} alt={record.brand.name} loading="lazy" decoding="async" /></span>
    ) : (
      <span class="achievement-emblem" aria-hidden="true">{record.label === copy.institutional ? 'ORG' : record.label}</span>
    )}
    {record.score && <span class:list={['cve-score-badge', { 'is-high': record.score >= 7 }]}>CVSS {record.score.toFixed(1)}</span>}
  </div>
  <div class="achievement-card-body">
    <div class="achievement-meta">
      <span>{record.label}</span>
      {record.year && <span>{record.year}</span>}
      {record.status && <span class="achievement-status">{record.status}</span>}
    </div>
    <h4>{record.title}</h4>
    {record.vendor && <p class="cve-target"><span>{record.vendor}</span>{record.product && <><i aria-hidden="true">/</i>{record.product}</>}</p>}
    {record.severity && <p class="cve-severity-line"><span class="cve-status-dot" aria-hidden="true"></span>{copy.severity}: <strong>{record.severity}</strong><small>CVSS v{record.cvssVersion}</small></p>}
    <p>{record.description}</p>
    {record.findingTitle && <p class="achievement-finding-title">{record.findingTitle}</p>}
    {record.findings && <ul class="achievement-findings" aria-label={record.title}>{record.findings.map((finding) => <li>{finding}</li>)}</ul>}
  </div>
  <div class="achievement-card-footer">
    <span>{record.url ? copy.publicRecord : copy.archived}</span>
    {record.url ? (
      <span class="achievement-card-actions">
        {record.evidence && <button type="button" data-evidence-open>{copy.evidence}</button>}
        <a class="cve-link cve-link--primary" href={record.url} target="_blank" rel="noopener noreferrer">
          {copy.verify} <span aria-hidden="true">↗</span><span class="sr-only">{copy.newTab}</span>
        </a>
        {record.secondaryUrl && <a class="cve-link" href={record.secondaryUrl} target="_blank" rel="noopener noreferrer">
          {copy.advisory} <span aria-hidden="true">↗</span><span class="sr-only">{copy.newTab}</span>
        </a>}
      </span>
    ) : <small>{copy.archive}</small>}
  </div>
</article>

{record.evidence && (
  <dialog class="evidence-dialog" data-evidence-dialog aria-labelledby={record.evidenceId}>
    <div class="evidence-dialog-bar">
      <div><span>{record.title}</span><h3 id={record.evidenceId}>{copy.evidence}</h3></div>
      <form method="dialog"><button type="submit" aria-label={copy.closeEvidence}>×</button></form>
    </div>
    <figure>
      <div class="evidence-dialog-media">
        <img class:list={['evidence-dialog-image', { 'is-wide': (record.evidenceWidth ?? 0) > (record.evidenceHeight ?? 1) * 1.4 }]} src={record.evidence} alt={record.evidenceAlt} width={record.evidenceWidth} height={record.evidenceHeight} loading="lazy" decoding="async" />
      </div>
      <figcaption>{record.evidenceAlt}</figcaption>
    </figure>
  </dialog>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-evidence-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = button.closest('.achievement-card')?.nextElementSibling;
      if (dialog instanceof HTMLDialogElement) {
        document.documentElement.classList.add('evidence-open');
        dialog.showModal();
      }
    });
  });

  document.querySelectorAll<HTMLDialogElement>('[data-evidence-dialog]').forEach((dialog) => {
    dialog.addEventListener('close', () => document.documentElement.classList.remove('evidence-open'));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .achievement-card--cve{isolation:isolate;padding:19px;background:linear-gradient(150deg,rgba(13,22,31,.98),rgba(8,13,19,.98));border-color:rgba(87,171,255,.22);border-top:1px solid rgba(87,171,255,.38)}
  .achievement-card--cve:before{position:absolute;z-index:-1;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(87,171,255,.035) 1px,transparent 1px),linear-gradient(rgba(87,171,255,.025) 1px,transparent 1px);background-size:22px 22px;content:"";mask-image:linear-gradient(to bottom,#000,transparent 68%)}
  .achievement-card--cve:after{position:absolute;top:0;left:18px;width:46px;height:2px;background:var(--accent-2);box-shadow:0 0 14px rgba(87,171,255,.7);content:""}
  .achievement-card--cve .achievement-card-top{min-height:38px;align-items:center}
  .achievement-card--cve .achievement-emblem{min-width:0;height:auto;padding:5px 8px;border:0;background:rgba(87,171,255,.09);border-radius:4px;font-size:10px;letter-spacing:.15em}
  .achievement-card--cve .achievement-card-body{margin-top:12px}
  .achievement-card--cve .achievement-meta{margin-bottom:5px;color:#7893b3}
  .achievement-card--cve h4{font:800 1.18rem/1.2 ui-monospace,monospace;letter-spacing:-.035em}
  .cve-score-badge{padding:6px 9px;color:#ffb86b;background:rgba(210,153,34,.08);border:1px solid rgba(210,153,34,.34);border-radius:5px;font:800 10px ui-monospace,monospace;letter-spacing:.04em;white-space:nowrap}
  .cve-score-badge.is-high{color:#ff7b72;background:rgba(248,81,73,.08);border-color:rgba(248,81,73,.38)}
  .cve-target{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-top:11px!important;color:var(--text)!important;font:700 .72rem/1.4 ui-monospace,monospace!important}
  .cve-target span{color:var(--accent-2)}.cve-target i{color:#4d6077;font-style:normal}
  .cve-severity-line{display:flex;align-items:center;gap:6px;margin-top:9px!important;color:#8796aa!important;font:700 9px ui-monospace,monospace!important;text-transform:uppercase;letter-spacing:.06em}
  .cve-severity-line strong{color:#ff7b72}.cve-severity-line small{margin-left:auto;color:#66758a;font-size:8px}
  .cve-status-dot{width:6px;height:6px;background:#ff5c57;border-radius:50%;box-shadow:0 0 8px rgba(255,92,87,.75)}
  .achievement-card--cve .achievement-finding-title{padding:0;color:#c7d2df!important;background:transparent;border:0;border-radius:0;font:700 .72rem/1.5 ui-monospace,monospace}
  .achievement-card--cve .achievement-card-footer{align-items:flex-end;gap:8px;padding-top:14px}
  .achievement-card--cve .achievement-card-footer>span:first-child{display:none}
  .achievement-card--cve .achievement-card-actions{width:100%;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .achievement-card--cve .cve-link{min-height:36px;justify-content:center;padding:6px 8px;color:#a7b5c6;border:1px solid #29384a;border-radius:5px;background:rgba(10,17,25,.72);font:700 9px/1.25 ui-monospace,monospace;text-align:center}
  .achievement-card--cve .cve-link--primary{color:var(--accent-2);border-color:rgba(87,171,255,.34)}
  .achievement-card--cve .cve-link:hover{color:var(--text);border-color:var(--accent-2);background:rgba(87,171,255,.07)}
  @media(max-width:430px){.achievement-card--cve{padding:17px}.achievement-card--cve .achievement-card-actions{grid-template-columns:1fr}.achievement-card--cve .cve-link{width:100%}}
</style>
