---
interface RecordItem {
  category: string;
  label: string;
  title: string;
  description: string;
  url?: string;
  year?: string;
  brand?: { logo: string; name: string };
  status?: string;
  findings?: readonly string[];
  evidence?: string;
  evidenceAlt?: string;
  evidenceWidth?: number;
  evidenceHeight?: number;
  evidenceId?: string;
  findingTitle?: string;
  secondaryUrl?: string;
  vendor?: string;
  product?: string;
  severity?: string;
  score?: number;
  cvssVersion?: string;
}

interface Copy {
  verify: string;
  newTab: string;
  archive: string;
  publicRecord: string;
  archived: string;
  institutional: string;
  evidence: string;
  closeEvidence: string;
  advisory: string;
  company: string;
  product: string;
  severity: string;
}

interface Props { record: RecordItem; copy: Copy; featured?: boolean }
const { record, copy, featured = false } = Astro.props;
---

<article class:list={['achievement-card', `achievement-card--${record.category}`, { 'achievement-card--featured': featured }]}> 
  <div class="achievement-card-top">
    {record.brand ? (
      <span class="achievement-logo-frame"><img src={record.brand.logo} alt={record.brand.name} loading="lazy" decoding="async" /></span>
    ) : (
      <span class="achievement-emblem" aria-hidden="true">{record.label === copy.institutional ? 'ORG' : record.label}</span>
    )}
  </div>
  <div class="achievement-card-body">
    <div class="achievement-meta">
      <span>{record.label}</span>
      {record.year && <span>{record.year}</span>}
      {record.status && <span class="achievement-status">{record.status}</span>}
    </div>
    <h4>{record.title}</h4>
    {record.vendor && (
      <dl class="achievement-cve-facts">
        <div><dt>{copy.company}</dt><dd>{record.vendor}</dd></div>
        {record.product && <div><dt>{copy.product}</dt><dd>{record.product}</dd></div>}
        {record.score && <div class="achievement-cve-score"><dt>{copy.severity}</dt><dd>CVSS {record.cvssVersion} · {record.score.toFixed(1)} {record.severity}</dd></div>}
      </dl>
    )}
    <p>{record.description}</p>
    {record.findingTitle && <p class="achievement-finding-title">{record.findingTitle}</p>}
    {record.findings && <ul class="achievement-findings" aria-label={record.title}>{record.findings.map((finding) => <li>{finding}</li>)}</ul>}
  </div>
  <div class="achievement-card-footer">
    <span>{record.url ? copy.publicRecord : copy.archived}</span>
    {record.url ? (
      <span class="achievement-card-actions">
        {record.evidence && <button type="button" data-evidence-open>{copy.evidence}</button>}
        <a href={record.url} target="_blank" rel="noopener noreferrer">
          {copy.verify} <span aria-hidden="true">↗</span><span class="sr-only">{copy.newTab}</span>
        </a>
        {record.secondaryUrl && <a href={record.secondaryUrl} target="_blank" rel="noopener noreferrer">
          {copy.advisory} <span aria-hidden="true">↗</span><span class="sr-only">{copy.newTab}</span>
        </a>}
      </span>
    ) : <small>{copy.archive}</small>}
  </div>
</article>

{record.evidence && (
  <dialog class="evidence-dialog" data-evidence-dialog aria-labelledby={record.evidenceId}>
    <div class="evidence-dialog-bar">
      <div><span>{record.title}</span><h3 id={record.evidenceId}>{copy.evidence}</h3></div>
      <form method="dialog"><button type="submit" aria-label={copy.closeEvidence}>×</button></form>
    </div>
    <figure>
      <div class="evidence-dialog-media">
        <img class:list={['evidence-dialog-image', { 'is-wide': (record.evidenceWidth ?? 0) > (record.evidenceHeight ?? 1) * 1.4 }]} src={record.evidence} alt={record.evidenceAlt} width={record.evidenceWidth} height={record.evidenceHeight} loading="lazy" decoding="async" />
      </div>
      <figcaption>{record.evidenceAlt}</figcaption>
    </figure>
  </dialog>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-evidence-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = button.closest('.achievement-card')?.nextElementSibling;
      if (dialog instanceof HTMLDialogElement) {
        document.documentElement.classList.add('evidence-open');
        dialog.showModal();
      }
    });
  });

  document.querySelectorAll<HTMLDialogElement>('[data-evidence-dialog]').forEach((dialog) => {
    dialog.addEventListener('close', () => document.documentElement.classList.remove('evidence-open'));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .achievement-cve-facts{display:grid;gap:8px;margin:14px 0 0}
  .achievement-cve-facts div{display:grid;grid-template-columns:minmax(72px,.35fr) 1fr;gap:10px;padding:8px 10px;background:rgba(248,81,73,.045);border-left:2px solid rgba(248,81,73,.55)}
  .achievement-cve-facts dt{color:var(--muted);font:700 10px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.06em}
  .achievement-cve-facts dd{margin:0;color:#ff7b72;font-weight:700;overflow-wrap:anywhere}
  .achievement-cve-score dd{color:#ff5c57}
  @media(max-width:520px){.achievement-cve-facts div{grid-template-columns:1fr;gap:4px}}
</style>
