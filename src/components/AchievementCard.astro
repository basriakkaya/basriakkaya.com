---
interface RecordItem {
  category: string;
  label: string;
  title: string;
  description: string;
  url?: string;
  year?: string;
  brand?: { logo: string; name: string };
}

interface Copy {
  verify: string;
  newTab: string;
  archive: string;
  publicRecord: string;
  archived: string;
  institutional: string;
}

interface Props { record: RecordItem; copy: Copy; featured?: boolean }
const { record, copy, featured = false } = Astro.props;
---

<article class:list={['achievement-card', `achievement-card--${record.category}`, { 'achievement-card--featured': featured }]}> 
  <div class="achievement-card-top">
    {record.brand ? (
      <span class="achievement-logo-frame"><img src={record.brand.logo} alt={record.brand.name} loading="lazy" decoding="async" /></span>
    ) : (
      <span class="achievement-emblem" aria-hidden="true">{record.label === copy.institutional ? 'ORG' : record.label}</span>
    )}
  </div>
  <div class="achievement-card-body">
    <div class="achievement-meta">
      <span>{record.label}</span>
      {record.year && <span>{record.year}</span>}
    </div>
    <h4>{record.title}</h4>
    <p>{record.description}</p>
  </div>
  <div class="achievement-card-footer">
    <span>{record.url ? copy.publicRecord : copy.archived}</span>
    {record.url ? (
      <a href={record.url} target="_blank" rel="noopener noreferrer">
        {copy.verify} <span aria-hidden="true">↗</span><span class="sr-only">{copy.newTab}</span>
      </a>
    ) : <small>{copy.archive}</small>}
  </div>
</article>
