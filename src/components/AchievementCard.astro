---
interface RecordItem {
  category: string;
  label: string;
  title: string;
  description: string;
  url?: string;
  year?: string;
  brand?: { logo: string; name: string };
  status?: string;
  findings?: readonly string[];
  evidence?: string;
  evidenceAlt?: string;
}

interface Copy {
  verify: string;
  newTab: string;
  archive: string;
  publicRecord: string;
  archived: string;
  institutional: string;
  evidence: string;
  closeEvidence: string;
}

interface Props { record: RecordItem; copy: Copy; featured?: boolean }
const { record, copy, featured = false } = Astro.props;
---

<article class:list={['achievement-card', `achievement-card--${record.category}`, { 'achievement-card--featured': featured }]}> 
  <div class="achievement-card-top">
    {record.brand ? (
      <span class="achievement-logo-frame"><img src={record.brand.logo} alt={record.brand.name} loading="lazy" decoding="async" /></span>
    ) : (
      <span class="achievement-emblem" aria-hidden="true">{record.label === copy.institutional ? 'ORG' : record.label}</span>
    )}
  </div>
  <div class="achievement-card-body">
    <div class="achievement-meta">
      <span>{record.label}</span>
      {record.year && <span>{record.year}</span>}
      {record.status && <span class="achievement-status">{record.status}</span>}
    </div>
    <h4>{record.title}</h4>
    <p>{record.description}</p>
    {record.findings && <ul class="achievement-findings" aria-label={record.title}>{record.findings.map((finding) => <li>{finding}</li>)}</ul>}
  </div>
  <div class="achievement-card-footer">
    <span>{record.url ? copy.publicRecord : copy.archived}</span>
    {record.url ? (
      <span class="achievement-card-actions">
        {record.evidence && <button type="button" data-evidence-open>{copy.evidence}</button>}
        <a href={record.url} target="_blank" rel="noopener noreferrer">
          {copy.verify} <span aria-hidden="true">↗</span><span class="sr-only">{copy.newTab}</span>
        </a>
      </span>
    ) : <small>{copy.archive}</small>}
  </div>
</article>

{record.evidence && (
  <dialog class="evidence-dialog" data-evidence-dialog aria-labelledby="nasa-evidence-title">
    <div class="evidence-dialog-bar">
      <div><span>NASA VDP</span><h3 id="nasa-evidence-title">{copy.evidence}</h3></div>
      <form method="dialog"><button type="submit" aria-label={copy.closeEvidence}>×</button></form>
    </div>
    <figure>
      <img src={record.evidence} alt={record.evidenceAlt} width="1788" height="474" loading="lazy" decoding="async" />
      <figcaption>{record.evidenceAlt}</figcaption>
    </figure>
  </dialog>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-evidence-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const dialog = button.closest('.achievement-card')?.nextElementSibling;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('[data-evidence-dialog]').forEach((dialog) => {
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
