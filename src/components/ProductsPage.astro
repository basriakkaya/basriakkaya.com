---
import BaseLayout from '../layouts/BaseLayout.astro';
import { alternateLinks } from '../i18n/helpers';
import { siteConfig } from '../config/site';
import { communityUrl } from '../data/editorial';
import type { Locale } from '../i18n/config';
const { locale = 'tr' } = Astro.props as { locale: Locale };
const en = locale === 'en';
---

<BaseLayout
  title={en ? 'KageTerm, KageAI & resources' : 'KageTerm, KageAI ve kaynaklar'}
  locale={locale}
  description={
    en
      ? 'Learn Linux commands by typing them in KageTerm. Explore KageAI, Basri Akkaya’s open-source projects and the Basrick community.'
      : 'KageTerm’de Linux komutlarını yazarak öğren. KageAI’ı, Basri Akkaya’nın açık kaynak projelerini ve Basrick topluluğunu keşfet.'
  }
  alternates={alternateLinks('/urunler', '/en/products')}
  switchPath={en ? '/urunler' : '/en/products'}
>
  <div class="shell">
    <header class="ed-page-head">
      <p class="ed-breadcrumb">{en ? 'HOME / PRODUCTS' : 'ANA SAYFA / ÜRÜNLER'}</p>
      <h1>{en ? 'Products & resources' : 'Ürünler ve kaynaklar'}</h1>
    </header>
    <article class="term-feature" id="kageterm">
      <div class="term-copy">
        <img src="/images/kageterm/mark.webp" width="64" height="64" alt="" />
        <h2>KageTerm</h2>
        <p class="term-tagline">{en ? 'Learn the command line by typing.' : 'Komut satırını yazarak öğren.'}</p>
        <p>{en
          ? 'Start with pwd to see what it does, then practise moving between directories and working with files. Track your typing speed and accuracy, or switch to Exam mode to test yourself.'
          : 'İlk alıştırmada pwd komutunun ne işe yaradığını gör. Ardından dizinler arasında gezinmeyi ve dosyalarla çalışmayı komutları yazarak öğren. Yazma hızını ve doğruluk oranını takip et, hazır olduğunda Sınav modunda kendini dene.'}</p>
        <a class="button primary" href="https://kageterm.com/" target="_blank" rel="noopener noreferrer">
          {en ? 'Practise in KageTerm' : 'KageTerm’de pratik yap'} ↗
        </a>
      </div>
      <figure>
        <img src={`/images/kageterm/practice-${locale}.webp`} width="1020" height="780"
          alt={en ? 'KageTerm showing the pwd command, its meaning and the on-screen keyboard' : 'KageTerm’de pwd komutu, açıklaması ve ekran klavyesi'} />
        <figcaption>{en ? 'Learn mode · Directory navigation' : 'Öğren modu · Dizinlerde gezinti'}</figcaption>
      </figure>
    </article>
    <article class="product-feature">
      <img src="/images/editorial/kageai-brand.svg" width="800" height="500" alt="" />
      <div>
        <p class="eyebrow">{en ? 'PRODUCT' : 'ÜRÜN'}</p>
        <h2>KageAI</h2>
        <p>
          {en
            ? 'Learn about KageAI and explore the product.'
            : 'KageAI hakkında bilgi edin ve ürünü keşfet.'}
        </p>
        <a
          class="button primary"
          href="https://kageai.tech"
          target="_blank"
          rel="noopener noreferrer"
        >
          {en ? 'Explore KageAI' : 'KageAI’ı incele'} ↗
        </a>
        <small>kageai.tech · {en ? 'External site' : 'Harici site'}</small>
      </div>
    </article>
    <article class="product-feature community">
      <div>
        <p class="eyebrow">{en ? 'COMMUNITY' : 'TOPLULUK'}</p>
        <h2>{en ? 'Basrick community' : 'Basrick topluluğu'}</h2>
        <p>
          {en
            ? 'Ask questions, discuss research and learn together.'
            : 'Sorularını paylaş, araştırmaları tartış, birlikte öğren.'}
        </p>
        <a class="button primary" href={communityUrl} target="_blank" rel="noopener noreferrer">
          {en ? 'Join Discord' : 'Discord’a katıl'} ↗
        </a>
      </div>
      <img
        src="/images/editorial/basrick.png"
        width="500"
        height="500"
        alt="Basrick"
        loading="lazy"
      />
    </article>
    <h2>{en ? 'Open source & notes' : 'Açık kaynak & notlar'}</h2>
    <div class="resource-rows">
      <a href={siteConfig.github} target="_blank" rel="noopener noreferrer">
        {en ? 'My GitHub projects' : 'GitHub çalışmalarım'} ↗
      </a>
      <a
        title={en ? 'Technical articles' : 'Teknik yazılar'}
        href={en ? '/en/articles' : '/yazilar'}
      >
        {en ? 'Technical articles' : 'Teknik yazılar'} →
      </a>
      <a href={siteConfig.community.website} target="_blank" rel="noopener noreferrer">
        BugHane Academy ↗
      </a>
    </div>
    <p>
      {en
        ? 'Product links open the provider’s website.'
        : 'Ürün bağlantıları ilgili sağlayıcının web sitesine yönlendirir.'}
    </p>
    <section class="contact-strip">
      <h2>{en ? 'Let’s create together.' : 'Birlikte üretelim.'}</h2>
      <p>
        {en
          ? 'Get in touch for collaborations, questions or feedback.'
          : 'İş birlikleri, sorular veya geri bildirimlerin için benimle iletişime geçebilirsin.'}
      </p>
      <button class="button primary" data-contact-open aria-haspopup="dialog">
        {en ? 'Contact me' : 'İletişime geç'} ↗
      </button>
    </section>
  </div>
</BaseLayout>

<style>
  .term-feature {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    align-items: center;
    margin-bottom: 30px;
    border: 1px solid var(--border);
    background: #0e0e0e;
  }
  .term-copy { padding: clamp(20px, 4vw, 56px); }
  .term-copy > img { display: block; object-fit: contain; }
  .term-copy h2 { margin: 12px 0 0; font-size: clamp(2.5rem, 5vw, 4.8rem); line-height: 1; }
  .term-copy .term-tagline { margin: 16px 0 10px; color: var(--accent); font-size: 1.25rem; font-weight: 650; }
  .term-copy p { line-height: 1.6; }
  .term-copy a { margin-top: 8px; }
  .term-feature figure { margin: 0; align-self: stretch; display: grid; align-content: center; background: #080808; }
  .term-feature figure img { width: 100%; height: auto; display: block; }
  .term-feature figcaption { padding: 12px 18px; color: #c2bfb3; font: .78rem/1.5 ui-monospace, monospace; }
  @media (max-width: 740px) { .term-feature { grid-template-columns: 1fr; } }
</style>
