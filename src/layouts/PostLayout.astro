---
import BaseLayout from './BaseLayout.astro';
import type { BlogPost } from '../lib/posts';
import { readingTime } from '../lib/reading-time';
import { absoluteUrl, siteConfig } from '../config/site';
import { breadcrumbSchema, personSchema, schemaGraph } from '../lib/schema';
import { postSlug } from '../lib/posts';

interface Props { post: BlogPost }
const { post } = Astro.props;
const { title, description, publishedAt, updatedAt, tags, cover } = post.data;
const slug = postSlug(post);
const postUrl = absoluteUrl(`/yazilar/${slug}`);
const format = (date: Date) => date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
const posting: Record<string, unknown> = {
  '@type': 'BlogPosting', headline: title, description, url: postUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  datePublished: publishedAt.toISOString(), dateModified: (updatedAt ?? publishedAt).toISOString(),
  author: { '@id': `${absoluteUrl('/')}#person` }, publisher: { '@id': `${absoluteUrl('/')}#person` },
  inLanguage: siteConfig.locale, keywords: tags.join(', '),
};
if (cover) posting.image = absoluteUrl(cover);
const jsonLd = schemaGraph([
  personSchema,
  posting,
  breadcrumbSchema([{ name: 'Ana Sayfa', path: '/' }, { name: 'Yazılar', path: '/yazilar' }, { name: title, path: `/yazilar/${slug}` }]),
]);
---
<BaseLayout title={title} description={description} type="article" image={cover} jsonLd={jsonLd}>
  <article class="article shell-narrow">
    <header class="article-header">
      <p class="eyebrow">$ cat yazilar/{post.id}</p><h1>{title}</h1><p class="lead">{description}</p>
      <div class="article-meta"><span>Yazar: {siteConfig.name}</span><span>·</span><time datetime={publishedAt.toISOString()}>{format(publishedAt)}</time><span>·</span><span>{readingTime(post.body ?? '')}</span>{updatedAt && <span>Güncellendi: <time datetime={updatedAt.toISOString()}>{format(updatedAt)}</time></span>}</div>
      <ul class="tag-list" aria-label="Etiketler">{tags.map((tag) => <li>{tag}</li>)}</ul>
    </header>
    <div class="prose"><slot /></div>
    <a class="back-link article-end-link" href="/yazilar">← Yazılara dön</a>
  </article>
</BaseLayout>
